{
  "rewrites": [
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebook|facebot|twitterbot|telegram|discord).*"
        }
      ],
      "destination": "/api/share.js?id=:id"
    },
    {
      "source": "/share/product/:id",
      "destination": "/api/share.js?id=:id"
    },
    { "source": "/api/(.*)", "destination": "http://localhost:3000/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
