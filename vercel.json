{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "http://localhost:3000/api/$1" },
    { "source": "/share/(.*)", "destination": "http://localhost:3000/share/$1" },
    { "source": "/uploads/(.*)", "destination": "http://localhost:3000/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
